"fullsize_spring_F": {
    "information":{
        "authors":"BeamNG",
        "name":"Front Springs",
        "value":150,
    },
    "slotType" : "fullsize_spring_F",
    "flexbodies": [
        ["mesh", "[group]:", "nonFlexMaterials"],
        ["fullsize_spring_F", ["fullsize_shockbottom_F","fullsize_shocktop_F"]],
    ],
    "beams": [
