          //front springs
          {"beamType":"|NORMAL"},
          {"beamDeform":25000,"beamStrength":250000},
          {"beamSpring":70000,"beamDamp":0},
          ["fh4r", "fs1r", {"precompressionRange":0.108,"soundFile":"event:>Vehicle>Suspension>car_modn_med_01>spring_compress_01","colorFactor":0.4,"attackFactor":30,"volumeFactor":1.4,"decayFactor":5,"noiseFactor":0.01,"pitchFactor":0.2,"maxStress":1000}],
          ["fh4l", "fs1l", {"precompressionRange":0.108,"soundFile":"event:>Vehicle>Suspension>car_modn_med_01>spring_compress_01","colorFactor":0.4,"attackFactor":30,"volumeFactor":1.4,"decayFactor":5,"noiseFactor":0.01,"pitchFactor":0.2,"maxStress":1000}],
