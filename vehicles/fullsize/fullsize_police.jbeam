"fullsize_flashers": {
    "information":{
        "authors":"BeamNG",
        "name":"Concealed Flashers",
        "value":200
    },
    "slotType" : "fullsize_flashers",
    "slots2": [
        ["name",          "allowTypes",      "denyTypes", "default",               "description"],
        ["flasher_color", ["flasher_color"], [],          "flasher_color_bluered", "Flashers Color", {"coreSlot":true}],
    ],
    "controller": [
        ["fileName"],
        ["lightbar", {
          "defaultModeIndex": 1,
          "name":"flashers",
          "modes": [
              ["name", "config"],
              ["Chase", [
                  ["electric", "value", "duration"],
                    ["blue_4", 1, 0.2],
                    ["blue_4", 0, 0.1],
                    ["blue_4", 1, 0.05],
                    ["blue_4", 0, 0.1],
                    ["blue_4", 1, 0.05],
                    ["blue_4", 0, 0.2],

                    ["red_4", 0, 0.1],
                    ["red_4", 1, 0.1],
                    ["red_4", 0, 0.1],
                    ["red_4", 1, 0.3],
                  ],
              ],
              ["Scene", [
                  ["electric", "value", "duration"],
                    ["blue_4", 1, 0.3],
                    ["blue_4", 0, 0.3],
                    ["blue_4", 1, 0.3],
                    ["blue_4", 0, 0.3],

                    ["red_4", 0, 0.3],
                    ["red_4", 1, 0.3],
                    ["red_4", 0, 0.3],
                    ["red_4", 1, 0.3],
                  ],
              ],
              ["Left Signal", [
                  ["electric", "value", "duration"],
                    ["red_4", 1, 0.2],
                    ["blue_4", 0, 0.2],
                    ["red_4", 0, 0.2],
                    ["blue_4", 1, 0.2],
                  ],
              ],
              ["Right Signal", [
                  ["electric", "value", "duration"],
                    ["red_4", 1, 0.2],
                    ["blue_4", 0, 0.2],
                    ["red_4", 0, 0.2],
                    ["blue_4", 1, 0.2],
                  ],
              ]
          ]
        }]
    ],
    "glowMap":{
          "generic_flasher_led_L": {"simpleFunction":"red_4", "off":"policeparts_lights_white", "on":"$=$components.lightbarMaterials.flasher1"},
          "generic_flasher_led_R": {"simpleFunction":"blue_4","off":"policeparts_lights_white", "on":"$=$components.lightbarMaterials.flasher2"},
    },
    "props": [
        ["func"      , "mesh"            , "idRef:", "idX:", "idY:"          , "baseRotation"        , "rotation"               , "translation"        , "min", "max", "offset", "multiplier"],
        {
            "lightInnerAngle":0,
            "lightOuterAngle":100,
            "lightBrightness":0.8,
            "lightRange":15,
            "lightColor":"$=$components.lightbarMaterials.lightColor_flasher2",
            "flareName":"vehicleBrakeLightFlare",
            "lightCastShadows":false,
            "texSize":64,
            "shadowSoftness":1,
            "flareScale":0.04,
            "cookieName":"/art/special/BNG_light_cookie_lightbar.dds"
        },
        ["blue_4"    , "SPOTLIGHT"        , "fb3rr", "fb3r", "fb2rr", {"x":180, "y":0, "z":0} , {"x":0, "y":0, "z":0}    , {"x":0, "y":0, "z":0}, 0, 0, 0, 1, {"baseTranslation":{"x":1.1, "y":0.5, "z":0.02},"deformGroup":"bumpersignal_R_break"}],
        ["blue_4"    , "SPOTLIGHT"        , "tb1r","tb1", "p9r", {"x":90, "y":-180, "z":180} , {"x":0, "y":0, "z":0}    , {"x":0, "y":0, "z":0}, 0, 0, 0, 1, {"baseTranslationGlobal":{"x":-0.3025, "y":1.82, "z":1.06},"deformGroup":"backlight_break","nodeOffset":{"x":0,"y":"$= $rearFlasherOffset == nil and 0 or $rearFlasherOffset","z":0}}],
        {
            "lightColor":"$=$components.lightbarMaterials.lightColor_flasher1",
        },
        ["red_4"    , "SPOTLIGHT"        , "fb3ll", "fb3l", "fb2ll", {"x":0, "y":0, "z":0} , {"x":0, "y":0, "z":0}    , {"x":0, "y":0, "z":0}, 0, 0, 0, 1, {"baseTranslation":{"x":1.1, "y":0.5, "z":-0.02},"deformGroup":"bumpersignal_L_break"}]
        ["red_4"    , "SPOTLIGHT"        , "tb1l","tb1", "p9l", {"x":90, "y":-180, "z":0} , {"x":0, "y":0, "z":0}    , {"x":0, "y":0, "z":0}, 0, 0, 0, 1, {"baseTranslationGlobal":{"x":0.3025, "y":1.82, "z":1.06},"deformGroup":"backlight_break","nodeOffset":{"x":0,"y":"$= $rearFlasherOffset == nil and 0 or $rearFlasherOffset","z":0}}],
    ],
    "flexbodies": [
        ["mesh", "[group]:", "nonFlexMaterials"],
        //flashers
        {"deformGroup":"bumpersignal_L_break", "deformMaterialBase":"policeparts_lights_white", "deformMaterialDamaged":"policeparts_lights_white"},
        ["generic_flasher_led_L",  ["fullsize_bumper_F"], [], {"pos":{"x": 0.43, "y":-2.35, "z":0.39}, "rot":{"x":0, "y":0, "z":0}, "scale":{"x":1.0, "y":1.0, "z":1.0}}],
        {"deformGroup":"bumpersignal_R_break", "deformMaterialBase":"policeparts_lights_white", "deformMaterialDamaged":"policeparts_lights_white"},
        ["generic_flasher_led_R", ["fullsize_bumper_F"], [], {"pos":{"x": -0.43, "y":-2.35, "z":0.39}, "rot":{"x":0, "y":0, "z":0}, "scale":{"x":1.0, "y":1.0, "z":1.0}}],
        {"deformGroup":"backlight_break", "deformMaterialBase":"policeparts_lights_white", "deformMaterialDamaged":"policeparts_lights_white"},
        ["generic_flasher_led_R", ["fullsize_body","fullsize_body_R"], [], {"pos":{"x":-0.260, "y":1.82, "z":1.06}, "rot":{"x":0, "y":0, "z":180}, "scale":{"x":1.3, "y":1.3, "z":1.10},"nodeOffset":{"x":0,"y":"$= $rearFlasherOffset == nil and 0 or $rearFlasherOffset","z":0}}],
        ["generic_flasher_led_L", ["fullsize_body","fullsize_body_R"], [], {"pos":{"x": 0.260, "y":1.82, "z":1.06}, "rot":{"x":0, "y":0, "z":180}, "scale":{"x":1.3, "y":1.3, "z":1.10},"nodeOffset":{"x":0,"y":"$= $rearFlasherOffset == nil and 0 or $rearFlasherOffset","z":0}}],
        ["generic_flasher_led_R", ["fullsize_body","fullsize_body_R"], [], {"pos":{"x":-0.345, "y":1.82, "z":1.06}, "rot":{"x":0, "y":0, "z":180}, "scale":{"x":1.3, "y":1.3, "z":1.10},"nodeOffset":{"x":0,"y":"$= $rearFlasherOffset == nil and 0 or $rearFlasherOffset","z":0}}],
        ["generic_flasher_led_L", ["fullsize_body","fullsize_body_R"], [], {"pos":{"x": 0.345, "y":1.82, "z":1.06}, "rot":{"x":0, "y":0, "z":180}, "scale":{"x":1.3, "y":1.3, "z":1.10},"nodeOffset":{"x":0,"y":"$= $rearFlasherOffset == nil and 0 or $rearFlasherOffset","z":0}}],
