        //automatic transmission
        ["gearModeIndex"      , "fullsize_shifter_A", "dsh2l","dshl","int_strw", {"x":0, "y":-10, "z":15}, {"x":0, "y":0, "z":-25}    , {"x":0, "y":0, "z":0}, 0, 1, 0, 1],
    ],
},
