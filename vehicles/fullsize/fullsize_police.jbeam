"fullsize_dash_police": {
    "information":{
        "authors":"BeamNG",
        "name":"Dashboard With Police Console",
        "value":500,
    },
    "slotType" : "fullsize_dash",
    "slots2": [
        ["name",                    "allowTypes",                "denyTypes", "default",                   "description"],
        ["fullsize_shifter_police", ["fullsize_shifter_police"], [],          "fullsize_shifter_A_police", "Shifter"],
        ["fullsize_steer",          ["fullsize_steer"],          [],          "fullsize_steer",            "Steering Wheel"],
        ["fullsize_dash_accessory", ["fullsize_dash_accessory"], [],          "fullsize_dash_radar",       "Interior Accessory"],
        ["fullsize_police_laptop",  ["fullsize_police_laptop"],  [],          "",                          "Police Laptop"],
    ],
    "props": [
        ["func",         "mesh",                   "idRef:", "idX:", "idY:", "baseRotation",            "rotation",                 "translation",         "min", "max", "offset", "multiplier"],
        //needles
        ["wheelspeed",   "fullsize_needle_speedo", "dsh","dshl","dsh2",        {"x":-85, "y":180, "z":180}, {"x":0, "y":0, "z":-4.15},  {"x":0, "y":0, "z":0}, 0, 53,   -26.1, 1],
        ["rpm",          "fullsize_needle_tacho",  "dsh","dshl","dsh2",        {"x":-85, "y":180, "z":180}, {"x":0, "y":0, "z":-0.035}, {"x":0, "y":0, "z":0}, 0, 6000, -3000, 1],
        ["fuel",         "fullsize_needle_fuel",   "dsh","dshl","dsh2",        {"x":-85, "y":180, "z":180}, {"x":0, "y":0, "z":-90},    {"x":0, "y":0, "z":0}, 0, 1,    -0.5,  1],
        ["oiltemp",      "fullsize_needle_oil",    "dsh","dshl","dsh2",        {"x":-85, "y":180, "z":180}, {"x":0, "y":0, "z":-1.5},   {"x":0, "y":0, "z":0}, 60, 120, -90, 1],
        ["watertemp",    "fullsize_needle_water",  "dsh","dshl","dsh2",        {"x":-85, "y":180, "z":180}, {"x":0, "y":0, "z":-1.5},   {"x":0, "y":0, "z":0}, 60, 120, -90, 1],
        ["volts",        "fullsize_needle_volts",  "dsh","dshl","dsh2",        {"x":-85, "y":180, "z":180}, {"x":0, "y":0, "z":-10},    {"x":0, "y":0, "z":0}, 11, 18,    0,    1],
        //pedals
        ["brake",        "fullsize_brakepedal",    "b1l","b1r","b5l",        {"x":8, "y":0, "z":180},   {"x":-25, "y":0, "z":0},    {"x":0, "y":0, "z":0}, 0, 1, 0, 1],
        ["throttle",     "fullsize_gaspedal",      "b1l","b1r","b5l",        {"x":0, "y":0, "z":180},   {"x":-20, "y":0, "z":0},    {"x":0, "y":0, "z":0}, 0, 1, 0, 1],
        ["parkingbrake", "fullsize_parkingbrake",  "b1l","b1r","b5l",        {"x":0, "y":0, "z":180},   {"x":-22, "y":0, "z":0},    {"x":0, "y":0, "z":0}, 0, 1, 0, 1],
        //turn signal stalk
        ["turnsignal",   "fullsize_signalstalk",   "b1l","b1r","b5l",        {"x":-72.5, "y":0, "z":180}, {"x":0, "y":0, "z":-15},  {"x":0, "y":0, "z":0}, -1, 1, 0, 1],
    ],
    "flexbodies": [
        ["mesh", "[group]:", "nonFlexMaterials"],
        //interior
        ["fullsize_dash", ["fullsize_dashboard"]],
        ["fullsize_gauges",  ["fullsize_dashboard"]],
        ["fullsize_center_console_police", ["fullsize_partition","fullsize_body","fullsize_body_F"]],
        ["fullsize_decals_gauges",  ["fullsize_dashboard"]],
    ],
    "triggers2":[
        ["id", "idRef:", "idX:", "idY:", "type", "size", "baseRotation", "rotation", "translation", "baseTranslation"],
        ["lightbar_toggle", "b2r","b2l","b1r", "box", {"x":0.015, "y":0.015, "z":0.050}, {"x": 0, "y":0, "z":0}, {"x":0, "y":0, "z":0}, {"x":0, "y":0, "z":0}, {"x": 0.258, "y": 0.120, "z": 0.280}],
        ["lightbar_mode1",  "b2r","b2l","b1r", "box", {"x":0.040, "y":0.010, "z":0.015}, {"x": 0, "y":0, "z":0}, {"x":0, "y":0, "z":0}, {"x":0, "y":0, "z":0}, {"x": 0.246, "y": 0.050, "z": 0.283}],
        ["lightbar_mode2",  "b2r","b2l","b1r", "box", {"x":0.040, "y":0.010, "z":0.015}, {"x": 0, "y":0, "z":0}, {"x":0, "y":0, "z":0}, {"x":0, "y":0, "z":0}, {"x": 0.246, "y": 0.026, "z": 0.283}],
        ["lightbar_mode3",  "b2r","b2l","b1r", "box", {"x":0.040, "y":0.010, "z":0.015}, {"x": 0, "y":0, "z":0}, {"x":0, "y":0, "z":0}, {"x":0, "y":0, "z":0}, {"x": 0.246, "y": 0.002, "z": 0.283}],
        ["lightbar_mode4",  "b2r","b2l","b1r", "box", {"x":0.040, "y":0.010, "z":0.015}, {"x": 0, "y":0, "z":0}, {"x":0, "y":0, "z":0}, {"x":0, "y":0, "z":0}, {"x": 0.246, "y":-0.022, "z": 0.283}],
        ["siren",           "b2r","b2l","b1r", "box", {"x":0.020, "y":0.025, "z":0.025}, {"x":50, "y":0, "z":0}, {"x":0, "y":0, "z":0}, {"x":0, "y":0, "z":0}, {"x": 0.395, "y": 0.195, "z": 0.305}],
    ],
    "actionsEnabled": [
        ["id"],
        ["toggle_lightbar"],
        ["toggle_siren"],
        ["lightbar_setmode_1"],
        ["lightbar_setmode_2"],
        ["lightbar_setmode_3"],
        ["lightbar_setmode_4"],
    ],
    "triggerEventLinks2":[
        ["triggerId:triggers2", "triggerInput", "inputAction"],
        ["lightbar_toggle","action0", "toggle_lightbar"],
        ["lightbar_mode1", "action0", "lightbar_setmode_1"],
        ["lightbar_mode2", "action0", "lightbar_setmode_2"],
        ["lightbar_mode3", "action0", "lightbar_setmode_3"],
        ["lightbar_mode4", "action0", "lightbar_setmode_4"],
        ["siren", "action0", "toggle_siren"],
    ],
    "controller": [
        ["fileName"],
        ["gauges/analogOdometer", {"name":"analogOdometer" }],
    ],
    "analogOdometer": {
        "configuration": {
            "materialName": "@fullsize_generic_odo",
            "htmlPath": "local://local/vehicles/common/analogOdo.html",
            "displayWidth":512,
            "displayHeight":32,
            "odometerDigits":7,
            "odometerHasDecimalSeparator":true,
            "tripHasDecimalSeparator":true,
            "unit":"imperial",
            "floatStyle":{"color":"black"},
            "bodyStyle":{
                "background": "url('/vehicles/common/odometer_analog_b.cef_color.png')",
                "font-family": "OpenSans",
                "font-size": "28px",
                "color": "white",
                "letter-spacing": "15.5px",
                "margin": "-4.5px 10.5px",
                "transform": "scaleX(1.26)",
                "transform-origin": "left",
            },
            "tripDivStyle":{
                "margin-left": "-3px",
                "position": "fixed",
                "letter-spacing": "32px"
            }
        },
    },
    "nodes": [
         ["id",   "posX", "posY", "posZ"],
         {"group":"fullsize_body"},
         {"selfCollision":true},
         {"collision":true},
         {"frictionCoef":0.5},
         {"nodeMaterial":"|NM_METAL"},

         //add weight
         {"nodeWeight":2.444},
         {"group":["fullsize_dashboard"]},
         ["dshr",-0.75,  -0.57,   0.95],
         ["dsh",  0.0,   -0.57,   0.95],
         ["dshl", 0.75,  -0.57,   0.95],
         ["dsh2", 0.0,   -0.57,   0.65],
         {"group":""},
    ],
}
"fullsize_shifter_A_police": {
    "information":{
        "authors":"BeamNG",
        "name":"Automatic Shifter",
        "value":750,
    },
    "slotType" : "fullsize_shifter_police",
    "controller": [
        ["fileName"],
        ["propAnimation/singleAxisLever", {"name":"singleAxisLever"}],

    ]
